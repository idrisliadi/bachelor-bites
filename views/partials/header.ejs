<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>
    <%= title || "Bachelor Bites " %>
  </title>

  <link
    rel="stylesheet"
    href="/css/style.css"
  >
</head>

<body>

<nav class="navbar">

  <a
    href="/"
    class="logo"
  >
    🍳 Bachelor Bites by aloma
  </a>

  <div class="nav-links">

    <a href="/">
      Home
    </a>

    <a href="/meals">
      Meals
    </a>

    <% if (user) { %>

      <a href="/meals/recommend">
        What should I eat?
      </a>

      <a href="/meals/cook">
        What can I cook?
      </a>

      <a href="/profile">
        Profile
      </a>

      <form
        action="/auth/logout"
        method="POST"
        style="display:inline"
      >
        <button class="logout">
          Logout
        </button>
      </form>

    <% } else { %>

      <a href="/auth/login">
        Login
      </a>

      <a
        href="/auth/register"
        class="nav-button"
      >
        Sign up
      </a>

    <% } %>

  </div>

</nav>

<main class="container">